# Solana RPC endpoint
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Discord webhook for alerts (optional)
DISCORD_WEBHOOK_URL=

# Upstash Redis for cloud state persistence (optional, for Render deployment)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# State storage configuration
STATE_KEY=cyberleek:state
LOCAL_STATE_PATH=./data/state.json

# Logging
LOG_LEVEL=info
